# BRING-UP ONLY (2026-10-09). Streams logcat to the serial console so zygote and
# system_server errors are visible without adb. Remove before shipping.
on init
    start bringup_logcat

service bringup_logcat /system/bin/logcat -b all -v threadtime
    user root
    group root log system
    console
    seclabel u:r:su:s0
